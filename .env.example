AGENT_URL=http://localhost:8123
OPENAI_API_KEY=

# GitHub fine-grained token: repository access to the PRs you review, with
# Pull requests read/write + Contents read. Needed to post suggestions and to
# read private repos.
GITHUB_TOKEN=

# Model for every model call in the agent: <provider>:<model>, provider one of
# openai, anthropic, google, xai (alias grok). Set the matching provider key for
# a non-OpenAI provider. For an OpenAI-compatible provider use
# openai:<its model id> and set OPENAI_BASE_URL.
COPILOTKIT_AGENT_MODEL=openai:gpt-5.4
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_BASE_URL=

# Per-step model routing (all optional, same <provider>:<model> format).
# Order: step var -> group var -> COPILOTKIT_AGENT_MODEL -> openai:gpt-5.4
# REVIEWER_MODEL=anthropic:claude-sonnet-5-5   # all three reviewers unless overridden below
# SECURITY_MODEL=anthropic:claude-opus-5-5     # security reviewer
# TESTS_MODEL=                                 # tests reviewer
# CORRECTNESS_MODEL=                           # correctness reviewer (REGRESSION_MODEL is a deprecated alias; LINT_MODEL is ignored)
# SUMMARY_MODEL=anthropic:claude-haiku-5-5     # summary (falls back to COPILOTKIT_AGENT_MODEL)
# CHAT_MODEL=                                  # chat replies (falls back to COPILOTKIT_AGENT_MODEL)

# Token cost: Claude Opus/Sonnet/Haiku 5.5 have built-in prices; other models show no cost
# unless priced here (USD per 1M tokens; cache_read optional).
# MODEL_PRICES={"openai:gpt-5.4": {"input": 2.5, "output": 15, "cache_read": 0.25}}

# Extra files to skip (comma-separated fnmatch globs) on top of lockfiles, minified, snapshots, generated/vendor dirs.
# REVIEW_IGNORE=src/gen/*,*.pb.ts

# Existing PR comments (bots, prior reviews, inline threads) are shown to the reviewers as untrusted leads.
# REVIEW_DISCUSSION=0              # set 0/false/off to disable (default on); GITHUB_TOKEN is needed to exclude resolved threads
# REVIEW_DISCUSSION_MAX_CHARS=12000  # character budget for the discussion block (default 12000)

# Time budgets in seconds. A reviewer over budget is marked timed out (others continue);
# a summary over budget falls back to a deterministic summary.
# REVIEWER_BUDGET_SECONDS=90
# SUMMARY_BUDGET_SECONDS=45

# --- CopilotKit Intelligence (optional; set CPK_INTELLIGENCE_API_KEY to enable Threads — server + UI) ---
# COPILOTKIT_LICENSE_TOKEN= # self-hosted/offline only
# INTELLIGENCE_API_URL=http://localhost:4201
# INTELLIGENCE_GATEWAY_WS_URL=ws://localhost:4401
# CPK_INTELLIGENCE_API_KEY=
