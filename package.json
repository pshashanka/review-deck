{
  "name": "review-deck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:infra && concurrently \"npm run dev:ui\" \"npm run dev:agent\" --names ui,agent --prefix-colors blue,green --kill-others",
    "dev:debug": "LOG_LEVEL=debug npm run dev",
    "dev:agent": "cd agent && uv run main.py",
    "dev:ui": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "install:agent": "cd agent && uv sync",
    "postinstall": "npm run install:agent",
    "dev:infra": "node scripts/copilotkit-dev-infra.mjs"
  },
  "dependencies": {
    "@copilotkit/a2ui-renderer": "1.79.0",
    "@copilotkit/react-core": "1.79.0",
    "@copilotkit/runtime": "1.79.0",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.10",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@ag-ui/encoder": "1.0.2",
    "@ag-ui/proto": "1.0.2"
  },
  "pnpm": {
    "overrides": {
      "@ag-ui/client": "1.0.2",
      "@ag-ui/core": "1.0.2",
      "@ag-ui/encoder": "1.0.2",
      "@ag-ui/proto": "1.0.2"
    }
  }
}
